FROM golang:1.26-bookworm@sha256:a688600ca24f8a4d3ca77f95b0dd40704a9fc787c826660eb7ba0b641b8b175d AS build
WORKDIR /src
# Build directly from the public release source, never a private .runtime checkout.
RUN git clone --filter=blob:none --no-checkout https://github.com/purpshell/meowcaller.git . && git checkout c48c3e2a243c672c942cbf0c941d14161720d540 && test "$(git rev-parse HEAD)" = c48c3e2a243c672c942cbf0c941d14161720d540
COPY deploy/whatsapp/meowcaller.patch /tmp/meowcaller.patch
RUN sed -i 's/\r$//' /tmp/meowcaller.patch && git apply --check /tmp/meowcaller.patch && git apply /tmp/meowcaller.patch
COPY scripts/whatsapp-caller/*.go /owned/
RUN mkdir -p cmd/whatsapp-caller && for file in /owned/*.go; do if grep -q '^package main' "$file"; then cp "$file" cmd/whatsapp-caller/; else cp "$file" .; fi; done
RUN --mount=type=cache,target=/root/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build CGO_ENABLED=0 go build -mod=readonly -trimpath -o /whatsapp-caller ./cmd/whatsapp-caller
RUN mkdir -p -m 0777 /data && chown 10000:10000 /data
FROM scratch
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /whatsapp-caller /whatsapp-caller
COPY --from=build /src/LICENSE /licenses/meowcaller-MIT.txt
COPY --from=build --chown=10000:10000 /data /data
USER 10000:10000

WORKDIR /data
ENTRYPOINT ["/whatsapp-caller"]
