# ==============================================================================
# BOX 1: Central AI Hermes Intelligence Runtime & Superpowers Stack
# Environment Configuration for Coolify / Docker Compose Deployment
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MANDATORY KEYS (Required for containers to start without errors)
# ------------------------------------------------------------------------------

# Shared authentication secret between Box 1 (Hermes) and Box 3 (App OS)
# MUST be at least 32 characters. Generate using: openssl rand -hex 24
HERMES_API_KEY=67f25f15c5509946682f77df9a4a602a6f290c5abf759fd7

# OpenRouter API Key for Hermes LLM reasoning, WhatsApp chat, and Hindsight memory
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# Fish Audio API Key for real-time Jarvis voice synthesis
FISH_API_KEY=sk-fish-your_fish_audio_api_key_here

# ------------------------------------------------------------------------------
# 2. PRE-CONFIGURED OPTIMAL MODEL ARCHITECTURE (Matching local ground truth)
# ------------------------------------------------------------------------------

# Core Hermes AI Engine
HERMES_CHAT_PROVIDER=openrouter
HERMES_CHAT_MODEL=nousresearch/hermes-4-405b

# Fast Telephony & Multi-Channel Chat (Sub-300ms latency)
WHATSAPP_CHAT_MODEL=deepseek/deepseek-v4.1-flash
HERMES_VOICE_PROVIDER=openrouter
HERMES_VOICE_MODEL=meta-llama/llama-3.3-70b-instruct

# Hindsight Long-Term Vector Memory (:8888)
HINDSIGHT_MODEL=deepseek/deepseek-chat-v3.1
HINDSIGHT_EMBEDDINGS_MODEL=openai/text-embedding-3-small
# Optional: Dedicated key for Hindsight if different from OPENROUTER_API_KEY
HINDSIGHT_API_LLM_API_KEY=

# Unified Fish Audio Voice Engine (Jarvis Voice)
FISH_VOICE_ID=612b878b113047d9a770c069c8b4fdfe
FISH_VOICE_NAME=Jarvis
CENTRAL_AI_CALL_SPEECH=fish
HERMES_CALL_SPEECH=fish
WHATSAPP_CONVERSATION_MODE=fish

# WhatsApp Calling Policy
WHATSAPP_ALLOW_ALL_INBOUND=true
TEXT_CHAT_ENABLED=true

# ------------------------------------------------------------------------------
# 3. INTER-BOX NETWORKING (Internal URLs)
# ------------------------------------------------------------------------------

# Box 3 App OS Internal URL (used by Box 1 MCP tools to trigger App OS widgets & DB)
APP_OS_URL=http://web:3000

# ------------------------------------------------------------------------------
# 4. OPTIONAL DIRECT PROVIDER KEYS & WORKSPACE INTEGRATIONS
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Google Workspace Integration (Calendar, Gmail, Drive)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
