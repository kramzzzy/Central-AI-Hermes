# ==============================================================================
# BOX 1: Central AI Hermes Intelligence Runtime & Superpowers Stack
# Environment Configuration for Coolify / Docker Compose Deployment
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MANDATORY KEYS (Required for containers to start without errors)
# ------------------------------------------------------------------------------

# Shared authentication secret between Box 1 (Hermes) and Box 3 (App OS)
# MUST be at least 32 characters. Generate using: openssl rand -hex 24
HERMES_API_KEY=67f25f15c5509946682f77df9a4a602a6f290c5abf759fd7

# OpenRouter API Key for Hermes LLM reasoning, WhatsApp chat, and Hindsight memory
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
SOCIAL_IMAGE_MODEL=google/gemini-nano-banana-2.1


# ------------------------------------------------------------------------------
# 2. PRE-CONFIGURED OPTIMAL MODEL ARCHITECTURE (Matching local ground truth)
# ------------------------------------------------------------------------------

# Core Hermes AI Engine
HERMES_CHAT_PROVIDER=openrouter
HERMES_CHAT_MODEL=deepseek/deepseek-chat-v3-0324

# Fast Telephony & Multi-Channel Chat (Sub-300ms latency)
WHATSAPP_CHAT_MODEL=openai/gpt-4o-mini
HERMES_VOICE_PROVIDER=openrouter
HERMES_VOICE_MODEL=openai/gpt-4o-mini

# Hindsight Long-Term Vector Memory (:8888)
HINDSIGHT_MODEL=openai/gpt-4o-mini
HINDSIGHT_EMBEDDINGS_MODEL=openai/text-embedding-3-small
# Optional: Dedicated key for Hindsight if different from OPENROUTER_API_KEY
HINDSIGHT_API_LLM_API_KEY=

CUSTOMER_VOICE_MODEL=openai/gpt-4o-mini
CUSTOMER_ANSWER_DELAY_SECONDS=0
OPENROUTER_TTS_MODEL=google/gemini-3.8-flash-lite-tts
OPENROUTER_TTS_VOICE=Charon
CUSTOMER_OPENROUTER_TTS_VOICE=Orus
CENTRAL_AI_CALL_SPEECH=openrouter
HERMES_CALL_SPEECH=openrouter
# Streaming audio transport; native Hermes owns the conversation and tools.
WHATSAPP_CONVERSATION_MODE=stream

# WhatsApp Calling Policy
WHATSAPP_ALLOW_ALL_INBOUND=true
TEXT_CHAT_ENABLED=true

# ------------------------------------------------------------------------------
# 3. INTER-BOX NETWORKING (Internal URLs)
# ------------------------------------------------------------------------------

# Box 3 App OS Internal URL (used by Box 1 MCP tools to trigger App OS widgets & DB)
APP_OS_URL=http://web:3000

# ------------------------------------------------------------------------------
# 4. OPTIONAL DIRECT PROVIDER KEYS
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Note: Google Workspace (Gmail, Calendar, Drive) OAuth credentials belong exclusively to Box 3 (App OS).

# ------------------------------------------------------------------------------
# Social sign-in (Settings -> Connection). One Meta App powers the normal
# Facebook Login popup for Facebook Pages + Instagram Business.
# Meta App -> Facebook Login for Business -> Valid OAuth Redirect URIs:
#   https://<your-app-os-domain>/api/connections/social/callback
# ------------------------------------------------------------------------------
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# Enable only after Meta grants instagram_manage_engagement, then reconnect.
META_INSTAGRAM_COMMENT_LIKES=0
# Optional override; defaults to the App OS origin that started the sign-in.
FACEBOOK_REDIRECT_URI=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
